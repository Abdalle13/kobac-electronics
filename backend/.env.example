PORT=5000
MONGODB_URI=
NODE_ENV=production
JWT_SECRET=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Your deployed frontend origin(s), no trailing slash, comma-separated for more than one.
# e.g. https://kobac-electronics.vercel.app
# CORS always also allows localhost and any *.vercel.app deployment.
FRONTEND_URL=
# Simulated EVC Plus gateway - the PIN customers must enter at checkout
EVC_DEMO_PIN=1234

# Transactional email (SMTP).
# Recommended: Brevo (free 300/day, far better inbox delivery than a personal Gmail).
#   1. brevo.com -> sign up -> Senders & IP -> verify the address you put in EMAIL_FROM
#   2. SMTP & API -> SMTP -> copy the login + generate a key
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_USER=<your brevo smtp login, e.g. 8xxxxx001@smtp-brevo.com>
#   EMAIL_PASS=<your brevo smtp key>
# Gmail also works for local testing (use an App Password, not your login):
#   EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Must be a verified sender in Brevo. Keep the address stable.
EMAIL_FROM=Kobac Electronics <you@example.com>
