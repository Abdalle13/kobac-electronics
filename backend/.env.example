PORT=5000
MONGODB_URI=
NODE_ENV=production
JWT_SECRET=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Your deployed frontend origin(s), no trailing slash, comma-separated for more than one.
# e.g. https://kobac-electronics.vercel.app
# CORS always also allows localhost and any *.vercel.app deployment.
FRONTEND_URL=
# Simulated EVC Plus gateway — the PIN customers must enter at checkout
EVC_DEMO_PIN=1234

# Transactional email (SMTP). For Gmail use an App Password, not your login password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Kobac Electronics <yourname@gmail.com>
